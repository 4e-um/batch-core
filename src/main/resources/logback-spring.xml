<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <springProperty name="APP_NAME" source="spring.application.name" defaultValue="batch-core"/>

    <!-- OTLP Appender: Logs → Alloy → Loki -->
    <appender name="OTEL" class="io.opentelemetry.instrumentation.logback.appender.v1_0.OpenTelemetryAppender">
        <captureExperimentalAttributes>true</captureExperimentalAttributes>
        <captureKeyValuePairAttributes>true</captureKeyValuePairAttributes>
    </appender>

    <!-- Console: for local development -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} [%X{traceId:-},%X{spanId:-}] - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- prod: OTLP + Console -->
    <springProfile name="prod | cloudrun">
        <root level="INFO">
            <appender-ref ref="OTEL"/>
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>

    <!-- dev/local: Console only -->
    <springProfile name="!prod &amp; !cloudrun">
        <root level="DEBUG">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>
</configuration>
